{
  "name": "slate-foundation",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:packages": "pnpm --filter './packages/**' build",
    "build": "pnpm build:packages && tsc --noEmit && vite build",
    "typecheck": "pnpm --filter './packages/**' typecheck && tsc --noEmit",
    "pretest": "pnpm build:packages",
    "test": "vitest run",
    "test:browser": "node app/tests/browser.mjs && node app/tests/advanced-browser.mjs && node app/tests/block-interactions-browser.mjs && node app/tests/workflow-browser.mjs && node app/tests/ownership-browser.mjs && node app/tests/structured-workspace-browser.mjs",
    "test:structured-workspace-browser": "node app/tests/structured-workspace-browser.mjs",
    "test:markdown-browser": "node app/tests/advanced-browser.mjs",
    "test:git-documents-browser": "node app/tests/git-documents-browser.mjs",
    "test:block-interactions-browser": "node app/tests/block-interactions-browser.mjs",
    "lint": "biome check .",
    "start": "node app/server.mjs",
    "docs:start": "node packages/block-docs/dist/cli.js start"
  },
  "dependencies": {
    "@block-editor/bindings": "workspace:*",
    "@block-editor/git-documents": "workspace:*",
    "@block-editor/git-documents-host": "workspace:*",
    "@block-editor/markdown": "workspace:*",
    "@block-editor/model": "workspace:*",
    "@block-editor/prosemirror": "workspace:*",
    "@block-editor/server-bindings": "workspace:*",
    "@block-editor/workspace": "workspace:*",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@radix-ui/react-icons": "^1.3.2",
    "@tanstack/react-virtual": "^3.14.13",
    "ky": "^2.1.0",
    "lib0": "^0.2.119",
    "markdown-it": "^15.0.2",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.10.5",
    "prosemirror-view": "^1.41.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.22.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.10",
    "jsdom": "^27.0.0",
    "playwright": "1.63.0",
    "react-grab": "^0.0.82",
    "react-scan": "^0.4.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.17.1"
}
