    },
    "./containers": {
      "types": "./dist/containers.d.ts",
      "import": "./dist/containers.js"
    },
    "./quote": {
      "types": "./dist/quote.d.ts",
      "import": "./dist/quote.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "import": "./dist/code.js"
    },
    "./caption": {
      "types": "./dist/caption.d.ts",
      "import": "./dist/caption.js"
